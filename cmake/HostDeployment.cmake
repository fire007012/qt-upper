# Native Linux/Windows deployment. Qt's generated script scans QML imports,
# plugins and runtime libraries; never copy the development tree wholesale.
include(GNUInstallDirs)
if(Qt6_VERSION VERSION_LESS "6.12")
    message(FATAL_ERROR "The runtime packaging workflow requires Qt 6.12 or newer")
endif()
set(HOST_FFMPEG_EXECUTABLE "" CACHE FILEPATH "Redistributable FFmpeg executable")
set(HOST_FFMPEG_LICENSE "" CACHE FILEPATH "License/notice for the selected FFmpeg build")
if(NOT EXISTS "${HOST_FFMPEG_EXECUTABLE}" OR NOT EXISTS "${HOST_FFMPEG_LICENSE}")
    message(FATAL_ERROR "Deployment requires HOST_FFMPEG_EXECUTABLE and HOST_FFMPEG_LICENSE")
endif()
if(NOT COMMAND qt_generate_deploy_qml_app_script)
    message(FATAL_ERROR "Qt with QML deployment support is required")
endif()
if(WIN32)
    set(CMAKE_INSTALL_BINDIR ".")
    set(HOST_FFMPEG_NAME ffmpeg.exe)
else()
    set(HOST_FFMPEG_NAME ffmpeg)
    set_target_properties(hostcomputer PROPERTIES INSTALL_RPATH "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
endif()
install(TARGETS hostcomputer RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}")
install(PROGRAMS "${HOST_FFMPEG_EXECUTABLE}"
    DESTINATION "${CMAKE_INSTALL_BINDIR}" RENAME "${HOST_FFMPEG_NAME}")
install(FILES "${HOST_FFMPEG_LICENSE}" DESTINATION licenses/ffmpeg)
if(TARGET SDL3::SDL3)
    if(WIN32)
        install(FILES "$<TARGET_FILE:SDL3::SDL3>" DESTINATION "${CMAKE_INSTALL_BINDIR}")
    else()
        get_target_property(host_sdl_target SDL3::SDL3 ALIASED_TARGET)
        install(TARGETS ${host_sdl_target} LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}")
    endif()
endif()
install(FILES "${CMAKE_SOURCE_DIR}/deploy/compatibility.json" DESTINATION .)
install(DIRECTORY "${CMAKE_SOURCE_DIR}/docs/" DESTINATION docs
    FILES_MATCHING PATTERN "*.md" PATTERN "开发归档" EXCLUDE)
install(FILES "${CMAKE_SOURCE_DIR}/README.md" DESTINATION .)
set(host_platform_plugins qoffscreen qminimal)
if(UNIX AND NOT APPLE)
    list(APPEND host_platform_plugins qwayland)
endif()
qt_generate_deploy_qml_app_script(TARGET hostcomputer OUTPUT_SCRIPT host_deploy_script
    INCLUDE_PLUGINS ${host_platform_plugins})
install(SCRIPT "${host_deploy_script}")
